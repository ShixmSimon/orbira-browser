From: WorkBuddy <wb@local>
Date: Thu, 23 Oct 2026 09:00:00 +0800
Subject: [OHOS] extension requests must not advertise chrome-extension:// Origin

Sites that validate the Origin request header for CSRF (e.g.
www.3gbizhi.com) answer 403 the moment an extension request
carries "Origin: chrome-extension://<id>". Extension requests
bypass CORS entirely, so the header buys nothing and only breaks
those sites.

Two layers must be patched:
1. Blink's ResourceRequestHead::SetHTTPOrigin() drops the header for
   chrome-extension origins (extension pages, service worker,
   offscreen document).
2. The network service re-adds the header from request_initiator in
   cors_url_loader.cc, which silently undoes (1). Drop it there too
   when the initiator scheme is chrome-extension.

Both files live outside overlay/, so the edits survive the
rsync overlay/ -> src/ sync; they were previously carried only by
D:/hmos-build/apply-engine-patches.py and are now a first-class
patch so every build path (apply-adapter / stage3d / CI) applies
them automatically.

diff --git a/services/network/cors/cors_url_loader.cc b/services/network/cors/cors_url_loader.cc
--- a/services/network/cors/cors_url_loader.cc
+++ b/services/network/cors/cors_url_loader.cc
@@ -1034,15 +1034,22 @@
         request_.headers.HasHeader(net::HttpRequestHeaders::kOrigin) &&
         AllowUnsafeHeaders();
 
-    if (!has_custom_origin_header_with_bypass) {
-      if (tainted_) {
-        request_.headers.SetHeader(net::HttpRequestHeaders::kOrigin,
-                                   url::Origin().Serialize());
-      } else {
-        request_.headers.SetHeader(net::HttpRequestHeaders::kOrigin,
-                                   request_.request_initiator->Serialize());
-      }
-    }
+    if (!has_custom_origin_header_with_bypass) {
+      // OHOS: extension-initiated requests do not advertise
+      // "chrome-extension://..." as their Origin. Sites that validate Origin
+      // for CSRF reject that value, and extension requests bypass CORS anyway,
+      // so leave the header out instead of synthesising it.
+      if (request_.request_initiator &&
+          request_.request_initiator->scheme() == "chrome-extension") {
+        request_.headers.RemoveHeader(net::HttpRequestHeaders::kOrigin);
+      } else if (tainted_) {
+        request_.headers.SetHeader(net::HttpRequestHeaders::kOrigin,
+                                   url::Origin().Serialize());
+      } else {
+        request_.headers.SetHeader(net::HttpRequestHeaders::kOrigin,
+                                   request_.request_initiator->Serialize());
+      }
+    }
   }
 
   if (fetch_cors_flag_ && request_.mode == mojom::RequestMode::kSameOrigin) {
diff --git a/third_party/blink/renderer/platform/loader/fetch/resource_request.cc b/third_party/blink/renderer/platform/loader/fetch/resource_request.cc
--- a/third_party/blink/renderer/platform/loader/fetch/resource_request.cc
+++ b/third_party/blink/renderer/platform/loader/fetch/resource_request.cc
@@ -328,9 +328,18 @@
   http_header_fields_.Set(name, value);
 }
 
-void ResourceRequestHead::SetHTTPOrigin(const SecurityOrigin* origin) {
-  SetHttpHeaderField(http_names::kOrigin, origin->ToAtomicString());
-}
+void ResourceRequestHead::SetHTTPOrigin(const SecurityOrigin* origin) {
+  // OHOS: requests made by an extension (its pages, service worker and
+  // offscreen document) do not advertise "chrome-extension://..." as their
+  // Origin. Sites that validate Origin for CSRF reject that value outright,
+  // and extension requests bypass CORS anyway, so leaving the header out is
+  // both safe and what the sites expect.
+  if (origin->Protocol() == "chrome-extension") {
+    http_header_fields_.Remove(http_names::kOrigin);
+    return;
+  }
+  SetHttpHeaderField(http_names::kOrigin, origin->ToAtomicString());
+}
 
 void ResourceRequestHead::ClearHTTPOrigin() {
   http_header_fields_.Remove(http_names::kOrigin);
