     ContextResult* result) {
   DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
 
+  // A failed context cannot be reused after an OHOS device reset. Exit the
+  // isolated GPU service on fatal creation failure so Chromium starts a fresh
+  // process, EGL display and device instead of spinning on the lost one.
+  const auto fail_shared_context =
